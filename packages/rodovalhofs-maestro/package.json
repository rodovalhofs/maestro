    "lib/atomic-file.js",
    "lib/cli.js",
    "lib/commands.js",
    "lib/detect-agents.js",
    "lib/doctor.js",
    "lib/install.js",
    "lib/paths.js",
    "lib/python.js",
    "lib/remove.js",
    "lib/run-manifest.js",
    "lib/runbook.js",
    "lib/setup.js",
    "skill/SKILL.md",
    "skill/discover-allowlist.example.txt",
    "skill/maestro-exclude.example.txt",
    "skill/scripts/bm25.py",
    "skill/scripts/build_manifest.py",
    "skill/scripts/catalog.py",
    "skill/scripts/concept_gaps.py",
    "skill/scripts/discovery.py",
    "skill/scripts/domains.py",
