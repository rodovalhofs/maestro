{
  "name": "@rodovalhofs/maestro",
  "version": "0.3.0",
  "description": "Maestro skill orchestrator — scoped install with short bin name",
  "license": "MIT",
  "author": "Yuri Rodovalho",
  "repository": {
    "type": "git",
