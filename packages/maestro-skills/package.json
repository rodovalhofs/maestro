{
  "name": "maestro-skills",
  "version": "0.3.0",
  "description": "Interactive setup for the Maestro skill orchestrator (multi-agent)",
  "license": "MIT",
  "author": "Yuri Rodovalho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodovalhofs/maestro.git",
    "directory": "packages/maestro-skills"
  },
  "homepage": "https://github.com/rodovalhofs/maestro#readme",
  "bugs": {
    "url": "https://github.com/rodovalhofs/maestro/issues"
  },
  "keywords": [
    "maestro",
    "cursor",
    "claude",
    "codex",
    "agent-skills",
    "skills",
    "orchestrator"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "maestro-skills": "./bin/cli.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "agents.json",
    "bin/cli.js",
    "designer/SKILL.md",
    "designer/references/task-spec-template.md",
    "lib/atomic-file.js",
    "lib/cli.js",
    "lib/commands.js",
    "lib/detect-agents.js",
    "lib/doctor.js",
    "lib/install.js",
    "lib/paths.js",
    "lib/python.js",
    "lib/remove.js",
    "lib/run-manifest.js",
    "lib/runbook.js",
    "lib/setup.js",
    "skill/SKILL.md",
    "skill/discover-allowlist.example.txt",
    "skill/maestro-exclude.example.txt",
    "skill/scripts/bm25.py",
    "skill/scripts/build_manifest.py",
    "skill/scripts/catalog.py",
    "skill/scripts/concept_gaps.py",
    "skill/scripts/discovery.py",
    "skill/scripts/domains.py",
    "skill/scripts/intents.py",
    "skill/scripts/invoke.ps1",
    "skill/scripts/invoke.sh",
    "skill/scripts/maestro_paths.py",
    "skill/scripts/route_tasks.py",
    "skill/scripts/routing.py",
    "skill/scripts/runbooks.py",
    "skill/scripts/search_skills.py",
    "skill/scripts/synonyms.py",
    "skill/skill-runbooks.json",
    "skill/skill-runbooks.md"
  ],
  "scripts": {
    "prepack": "node ../../scripts/sync-skill-to-cli.mjs --target maestro-skills",
    "prepublishOnly": "node -e \"const fs=require('fs'); if(!fs.existsSync('skill/SKILL.md')){console.error('Missing skill/ — run sync-skill-to-cli'); process.exit(1)}\"",
    "test": "node --test"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "commander": "^13.1.0",
    "maestro-monorepo": "file:../.."
  }
}
